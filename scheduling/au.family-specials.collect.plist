<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Runs scripts/mac-update.sh twice a day: it collects only the stores set to run_on: mac, and only
  when they're due this specials cycle (Woolworths and Coles weekly from Wednesday, ALDI on
  Wednesdays and Saturdays, Costco weekly from Monday, Chemist Warehouse weekly from Thursday).
  If the Mac is asleep at 7:30, launchd runs the job when it wakes.
  Install: see README.md ("Scheduling").
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>au.family-specials.collect</string>
  <key>WorkingDirectory</key>
  <string>/Users/marqueztandog/Claude/family-specials</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/marqueztandog/Claude/family-specials/scripts/mac-update.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Hour</key><integer>18</integer><key>Minute</key><integer>30</integer></dict>
  </array>
  <key>StandardOutPath</key>
  <string>/Users/marqueztandog/Claude/family-specials/data/logs/collect.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/marqueztandog/Claude/family-specials/data/logs/collect.log</string>
  <key>LowPriorityIO</key>
  <true/>
</dict>
</plist>
