# Copy to .env and fill in. .env is never committed.
# Chemist Warehouse public search key (from the network calls its category pages make).
CW_ALGOLIA_SEARCH_KEY=
# Signs phone notifications. Made by `uv run specials notify keys`; never share it.
VAPID_PRIVATE_KEY=
# Family backend (Supabase). Filled in by `uv run specials backend connect`; never share them.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
