# Copy to .env and fill in. .env is never committed.
# Chemist Warehouse public search key (from the network calls its category pages make).
CW_ALGOLIA_SEARCH_KEY=
# Signs phone notifications. Made by `uv run specials notify keys`; never share it.
VAPID_PRIVATE_KEY=
# Family backend (Supabase). Filled in by `uv run specials backend connect`; never share them.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Our family in Supabase (the one the private watchlist belongs to). Found by the first `specials update`.
SUPABASE_FAMILY_ID=
# Reads Chemist Warehouse's catalogue pages (Anthropic API). Set by `uv run specials catalogue key`.
ANTHROPIC_API_KEY=
# Password-reset emails: the app's Gmail account and its app password. Set by `uv run specials backend email`.
SMTP_SENDER=
SMTP_PASSWORD=
